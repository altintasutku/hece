{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/scripts/dev-cleanup.ps1\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) 'scripts/dev-cleanup.ps1')\"",
            "timeout": 60,
            "statusMessage": "Cleaning merged worktrees and build caches"
          }
        ]
      }
    ]
  }
}
